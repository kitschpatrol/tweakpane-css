{
	"name": "tweakpane-css",
	"version": "2.6.2",
	"description": "Detect and tweak CSS variables at runtime.",
	"keywords": [
		"tweakpane",
		"svelte",
		"css",
		"developer-tools",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/tweakpane-css",
	"bugs": "https://github.com/kitschpatrol/tweakpane-css/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/tweakpane-css.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com/"
	},
	"sideEffects": true,
	"type": "module",
	"main": "dist/main.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "vite build",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "npm-run-all --parallel dev:*",
		"dev:build": "vite build --watch",
		"dev:serve": "vite",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"preview": "vite preview",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vite build && playwright test"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.12.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/qs": "^6.15.1",
		"bumpp": "^12.3.0",
		"color-parse": "^2.1.2",
		"element-ready": "^9.0.2",
		"npm-run-all": "^4.1.5",
		"qs": "^6.16.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-persisted-store": "^0.12.0",
		"svelte-tweakpane-ui": "^1.6.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"vite-plugin-live-reload": "^3.1.0"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	}
}
